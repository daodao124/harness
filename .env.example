DEMO_ADMIN_API_KEY=change-me
DATABASE_PATH=./payment_service.db
DEGRADED_FAILURE_RATE=0.5
RANDOM_SEED=7
MAX_FAULT_DURATION_SECONDS=3600

# Agent model selection: api (OpenAI) or local (Ollama)
LLM_PROVIDER=api
AGENT_MAX_EXECUTION_SECONDS=120
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible API endpoint
OPENAI_BASE_URL=

OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
